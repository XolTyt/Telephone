# Vercel production: turn on the bundled /api/ice endpoint.
# Set these three variables in Vercel project settings before deployment:
# VITE_ICE_SERVERS_URL=/api/ice
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=the-same-secret-as-static-auth-secret-in-coturn

# Alternative: external HTTPS endpoint returning an array of RTCIceServer objects.
# VITE_ICE_SERVERS_URL=https://your-backend.example.com/ice

# Optional own PeerServer; default is PeerJS Cloud.
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/peerjs
# One-link calls (recommended). Add these in Vercel for Production + Preview.
# No VITE_ prefix on the service credentials: they must stay on the server.
# VITE_CALL_ENGINE=livekit
# LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# LIVEKIT_API_KEY=your-api-key
# LIVEKIT_API_SECRET=your-api-secret

# Default one-link calling engine (Metered): owner publishable key only.
# METERED_PUBLISHABLE_KEY=pk_live_...
# If migrating from another engine: VITE_CALL_ENGINE=metered (or remove the variable).
# The key can instead be bundled in config/call-service.js; never use an sk_ secret.
